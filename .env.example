# Required: the fixed upstream HTTP(S) origin, without a URL path or credentials.
# Host installation example: make Sub2API reachable on the Docker host gateway.
SUB2API_UPSTREAM=http://host.docker.internal:8081
# If both containers share an existing network and it exposes the alias sub2api:
# SUB2API_UPSTREAM=http://sub2api:8080

# Public browser origin, especially behind an HTTPS reverse proxy.
# CSHELL_PUBLIC_URL=https://panel.example.com

# Local binary defaults (Compose fixes these to 0.0.0.0:8080 and /app/frontend/dist).
# CSHELL_LISTEN=0.0.0.0:8080
# CSHELL_STATIC_DIR=frontend/dist

# Docker Compose only; publish to loopback by default.
# CSHELL_HOST_BIND=127.0.0.1
# CSHELL_HOST_PORT=8080
# CSHELL_NETWORK=your_existing_sub2api_network
# CSHELL_NETWORK_EXTERNAL=true

# TCP/TLS connection timeout in seconds (1..300); not a response body timeout.
# CSHELL_CONNECT_TIMEOUT_SECS=5
# Trust only the actual ingress proxy CIDRs; empty trusts no proxies.
# CSHELL_TRUSTED_PROXY_CIDRS=192.0.2.10/32,2001:db8::10/128
